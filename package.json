{
  "name": "axiom-ontology-workbench",
  "productName": "Axiom",
  "version": "1.0.0",
  "description": "A desktop ontology workbench",
  "author": "Craig Trim",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "benchmark": "tsx tests/performance/benchmark.ts",
    "format": "prettier --write src tests scripts package.json tsconfig.json playwright.config.ts vitest.config.ts",
    "benchmark:desktop": "npm run build && node scripts/desktop-benchmark.mjs",
    "test:codex": "node scripts/test-codex.mjs",
    "test:sparql": "vitest run tests/domain/sparql-conformance.test.ts tests/domain/sparql-literals.test.ts --reporter=default --reporter=json --outputFile=artifacts/sparql-conformance.json"
  },
  "dependencies": {
    "@comunica/actor-function-factory-term-datatype": "5.4.0",
    "@comunica/actor-function-factory-term-encode-for-uri": "5.4.0",
    "@comunica/actor-function-factory-term-equality": "5.4.0",
    "@comunica/actor-function-factory-term-lang": "5.4.0",
    "@comunica/query-sparql-rdfjs": "5.4.1",
    "@comunica/utils-expression-evaluator": "5.4.0",
    "@traqula/generator-sparql-1-1": "1.3.1",
    "@traqula/parser-sparql-1-1": "1.3.1",
    "@traqula/rules-sparql-1-1": "1.3.0",
    "ag-grid-community": "36.1.0",
    "ag-grid-react": "36.1.0",
    "electron-updater": "^6.8.9",
    "elkjs": "0.12.0",
    "exiftool-vendored.exe": "13.59.2",
    "flexlayout-react": "0.11.0",
    "jsonld-streaming-parser": "^5.0.1",
    "monaco-editor": "0.56.0",
    "n3": "^2.7.12",
    "rdfxml-streaming-parser": "^3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/n3": "^1.26.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/utif": "^3.0.6",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "rdf-canonize": "5.0.0",
    "saxes": "6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.15"
  },
  "type": "module"
}
